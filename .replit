entrypoint = "src/hosted/server.ts"
run = "npm run hosted"
modules = ["nodejs-20", "web"]

[deployment]
run = ["npm", "run", "hosted"]
deploymentTarget = "vm"

[nix]
channel = "stable-25_05"

[userenv]

[userenv.shared]
PORT = "5000"
PUBLIC_URL = "https://valuaraicoach.replit.app"

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Start application"

[[workflows.workflow]]
name = "Start application"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "npm run hosted"
waitForPort = 5000

[workflows.workflow.metadata]
outputType = "webview"

[[ports]]
localPort = 5000
externalPort = 80

[[ports]]
localPort = 5011
externalPort = 3001
