STRAVA_CLIENT_ID=your_client_id
STRAVA_CLIENT_SECRET=your_client_secret
STRAVA_REDIRECT_URI=http://localhost:8080/auth/callback

# --- Hosted server (npm run hosted) ---
# Public HTTPS URL this server is reachable at once deployed (e.g. on Replit).
PUBLIC_URL=https://your-app.replit.app
# PORT is provided automatically by most hosts (e.g. Replit); only set it locally if needed.
# PORT=3000

# Optional: lets a pre-configured ChatGPT Custom GPT Action authenticate, since
# ChatGPT's Action auth UI requires a fixed Client ID/Secret (no dynamic registration).
# Generate a random secret yourself, e.g.: openssl rand -hex 32
CHATGPT_CLIENT_SECRET=
# Comma-separated list of redirect URIs ChatGPT shows you when you set Action auth to OAuth.
CHATGPT_REDIRECT_URIS=
